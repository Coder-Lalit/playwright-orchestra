NODE_ENV=development
PORT=3000
LOG_LEVEL=info

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=automation
POSTGRES_USER=automation
POSTGRES_PASSWORD=automation

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts

DUMMY_APP_URL=http://localhost:4173
DUMMY_FAILURE_RATE=0.02
DUMMY_FLAKY_RATE=0.01
MAX_RETRIES=2
WORKER_REPLICAS=5
WORKER_CONCURRENCY=2
MAX_CONCURRENT_TESTS=10
TEST_COUNT=10000
DEFAULT_BROWSER=chromium
TARGET_DURATION_MINUTES=120
SIMULATE_WORKER_FAILURE=false

PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_EXPECT_TIMEOUT=10000
PLAYWRIGHT_VIDEO=true
PLAYWRIGHT_TRACE=true
PLAYWRIGHT_SCREENSHOT=true
PLAYWRIGHT_WORKERS=1
E2E_TARGET=queue
E2E_DIR=tests/e2e
RUN_NAME=
