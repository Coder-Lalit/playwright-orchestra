{
  "name": "automation-platform-poc",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "orchestrator": "tsx apps/orchestrator/src/index.ts",
    "scheduler": "tsx apps/scheduler/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "execution-store": "tsx apps/execution-store/src/index.ts",
    "generate-tests": "tsx scripts/generate-tests.ts",
    "run:10k": "tsx scripts/run-10k.ts",
    "run:load": "tsx scripts/run-load.ts",
    "run:e2e": "tsx scripts/run-e2e.ts",
    "run:e2e:local": "E2E_TARGET=local tsx scripts/run-e2e.ts",
    "run:e2e:queue": "E2E_TARGET=queue tsx scripts/run-e2e.ts",
    "test:dummy": "tsx tests/dummy/src/index.ts",
    "test:e2e": "playwright test",
    "test:wikipedia": "playwright test tests/e2e",
    "start": "docker compose -f infra/docker-compose.yml up --build"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.6",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "amqplib": "^0.10.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "minio": "^8.0.7",
    "pg": "^8.16.0",
    "@playwright/test": "^1.49.1",
    "playwright": "^1.49.1",
    "redis": "^5.0.0",
    "zod": "^3.25.0"
  }
}
